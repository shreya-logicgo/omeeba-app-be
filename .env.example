# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb+srv://nikunjgoyani5_db_user:YK11YQrfCyMb5Xje@omiba.dtkcoo8.mongodb.net/omiba_staging
MONGODB_URI_TEST=mongodb+srv://nikunjgoyani5_db_user:YK11YQrfCyMb5Xje@omiba.dtkcoo8.mongodb.net/omiba_staging

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRE=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@omeeba.com

# Brevo API Configuration
BREVO_API_KEY=your-brevo-api-key-v3
BREVO_SMTP_LOGIN=your-brevo-smtp-login
BREVO_SMTP_PASSWORD=your-brevo-smtp-password

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# OTP Configuration
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Share Link Base URL
SHARE_BASE_URL=https://staging.omeeba.co.in/share

# Apple App Store Configuration
APPLE_APP_SECRET=""

# Google Play Store Configuration
# Note: Google service account credentials should be stored in:
# config/google-service-account.json
# This file should NOT be committed to version control
# See .gitignore for exclusion details

# ACRCloud Audio & Video Recognition
ACR_HOST=your-project-host.acrcloud.com
ACR_ACCESS_KEY=your-access-key
ACR_ACCESS_SECRET=your-access-secret
